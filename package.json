{
  "name": "vimrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VimRace — a single-player, race-against-time Vim motion arcade game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
